# Copy to .env for local development. Never commit a real connection string.

# Required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger

# Server.
BIND_ADDR=0.0.0.0:3000
REQUEST_TIMEOUT_SECS=30
MAX_BODY_BYTES=65536
SHUTDOWN_GRACE_SECS=20

# Connection pool.
DATABASE_MAX_CONNECTIONS=16
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECS=10
DATABASE_MAX_LIFETIME_SECS=1800
DATABASE_IDLE_TIMEOUT_SECS=600

# Server-side safety limits. A transfer holds row locks on two accounts, so a
# wedged session blocks every other transfer touching them until it is killed.
# statement_timeout includes lock wait time and must exceed lock_timeout.
DATABASE_STATEMENT_TIMEOUT_SECS=30
DATABASE_LOCK_TIMEOUT_SECS=5
DATABASE_IDLE_IN_TXN_TIMEOUT_SECS=30

# Security policy. `allows_negative_balance` is the one control separating an
# ordinary account from one that can mint money, so opening a funding account
# over HTTP is an operator decision, not a caller's. Defaults to false; enable
# briefly at provisioning time, or seed funding accounts out of band.
ALLOW_FUNDING_ACCOUNT_CREATION=false

# Observability. LOG_FORMAT=json emits structured logs for an aggregator.
RUST_LOG=info,sqlx=warn
LOG_FORMAT=text
